{
  "schema_version": 2,
  "id": "clean-numbers",
  "title": "숫자 정제",
  "type": "algorithm",
  "category": "데이터 정제",
  "difficulty": "basic",
  "skills": ["문자열 정제", "타입 변환"],
  "submission": { "entry": "repo/solution.py", "runtime": "judge-py:base" },
  "open": {
    "kind": "pytest-visible",
    "cmd": "python3 -m pytest repo/tests/test_visible.py -q --tb=short"
  },
  "hidden": {
    "kind": "pytest-hidden",
    "cases": [
      { "id": "test_thousands_comma", "weight": 2 },
      { "id": "test_blank_to_none",   "weight": 2 },
      { "id": "test_trim_ws",         "weight": 1 },
      { "id": "test_negative",        "weight": 1 },
      { "id": "test_decimal",         "weight": 1 },
      { "id": "test_currency",        "weight": 1 }
    ]
  },
  "scoring": {
    "axes": [
      { "key": "accuracy",         "weight": 0.65 },
      { "key": "turn_efficiency",  "weight": 0.20 },
      { "key": "token_efficiency", "weight": 0.15 }
    ]
  },
  "par": { "turns": 3, "tokens": 6000, "time_sec": 540 },
  "trap_note": "naive int(x) raises: must strip thousands comma, blank->None, trim ws, handle negative/decimal/currency symbol."
}
