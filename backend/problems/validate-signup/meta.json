{
  "schema_version": 2,
  "id": "validate-signup",
  "title": "회원가입 검증",
  "type": "algorithm",
  "category": "API 구현",
  "difficulty": "mid",
  "skills": ["입력 검증", "정규식"],
  "submission": { "entry": "repo/solution.py", "runtime": "judge-py:base" },
  "open": {
    "kind": "pytest-visible",
    "cmd": "python3 -m pytest repo/tests/test_visible.py -q --tb=short"
  },
  "hidden": {
    "kind": "pytest-hidden",
    "cases": [
      { "id": "test_required_fields", "weight": 1 },
      { "id": "test_email_format",    "weight": 2 },
      { "id": "test_password_rule",   "weight": 2 },
      { "id": "test_trims",           "weight": 1 },
      { "id": "test_reject_extra",    "weight": 1 },
      { "id": "test_type_confusion",  "weight": 1 }
    ]
  },
  "scoring": {
    "axes": [
      { "key": "accuracy",         "weight": 0.65 },
      { "key": "turn_efficiency",  "weight": 0.20 },
      { "key": "token_efficiency", "weight": 0.15 }
    ]
  },
  "trap_note": "must check email format, password rules, trim email, reject undefined fields, guard non-str types. naive presence-only check fails."
}
