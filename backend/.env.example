# LLM endpoint — OpenAI-compatible. One hosted model for all users (no BYO-model).
# Default targets a local Ollama. To use a remote Ollama over ngrok, set OPENAI_BASE_URL
# to the tunnel URL + /v1 (e.g. https://abc123.ngrok-free.app/v1).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5-coder:7b

# Gemini API — 문제 자동 생성에 사용. https://aistudio.google.com/app/apikey 에서 발급.
GEMINI_API_KEY=
